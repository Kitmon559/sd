--==============================================================
-- SERIALIZE / PARSE
--==============================================================
local function serialize(v, seen)
    seen = seen or {}
    local t = type(v)
    if t == "string" then return string.format("%q", v)
    elseif t == "number" or t == "boolean" then return tostring(v)
    elseif t == "nil" then return "nil"
    elseif t == "table" then
        if seen[v] then return "--[[cycle]]" end
        seen[v] = true
        local keys, isArray = {}, true
        for k in pairs(v) do
            table.insert(keys, k)
            if type(k) ~= "number" then isArray = false end
        end
        table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
        local parts = {}
        if isArray then
            for _, k in ipairs(keys) do table.insert(parts, serialize(v[k], seen)) end
        else
            for _, k in ipairs(keys) do
                local key = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k
                            or ("[" .. serialize(k, seen) .. "]")
                table.insert(parts, key .. " = " .. serialize(v[k], seen))
            end
        end
        seen[v] = nil
        return "{ " .. table.concat(parts, ", ") .. " }"
    end
    return "nil"
end

local function parseValue(str)
    if type(str) ~= "string" then return str end
    str = str:gsub("^%s+", ""):gsub("%s+$", "")
    if str == "" then return nil end
    local fn = loadstring or load
    if fn then
        local ok, chunk = pcall(fn, "return " .. str)
        if ok and chunk then
            local ok2, r = pcall(chunk)
            if ok2 then return r end
        end
    end
    if str == "true"  then return true  end
    if str == "false" then return false end
    if str == "nil"   then return nil   end
    local num = tonumber(str)
    if num then return num end
    if (str:sub(1,1) == '"' and str:sub(-1) == '"') or
       (str:sub(1,1) == "'" and str:sub(-1) == "'") then
        return str:sub(2, -2)
    end
    return str
end

local function shortPreview(args, maxLen)
    maxLen = maxLen or 90
    local s = serialize(args)
    if #s > maxLen then s = s:sub(1, maxLen - 3) .. "..." end
    return s
end

