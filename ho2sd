    end)

    local mx = mousePos.X - Main.AbsolutePosition.X
    local my = mousePos.Y - Main.AbsolutePosition.Y
    local mw, mh = Main.AbsoluteSize.X, Main.AbsoluteSize.Y
    local cw = ContextMenu.AbsoluteSize.X
    if mx + cw > mw - 8 then mx = mw - cw - 8 end
    if mx < 8 then mx = 8 end
    if my < 8 then my = 8 end
    ContextMenu.Position = UDim2.new(0, mx, 0, my)

    -- Клик вне меню закрывает
    task.defer(function()
        local conn
        conn = UIS.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2 then
                task.wait(0.05)
                destroyContextMenu()
                if conn then conn:Disconnect() end
            end
        end)
    end)
end

