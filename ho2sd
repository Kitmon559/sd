    local function collectArgs()
        local out = {}
        for i = 1, #entry.args do out[i] = draft[i] end
        return out
    end

    SaveBtn.MouseButton1Click:Connect(function()
        C.rules[entry.name] = {
            args = collectArgs(),
            enabled = C.rules[entry.name] and C.rules[entry.name].enabled or true,
        }
        refreshHookBtn()
        SaveBtn.Text = "✅  Saved!"
        task.delay(1, function()
            if SaveBtn.Parent then SaveBtn.Text = "💾  Save rule" end
        end)
    end)

    ApplyBtn.MouseButton1Click:Connect(function()
        C.rules[entry.name] = { args = collectArgs(), enabled = true }
        C.enabled = true
        refreshHookBtn()
        ApplyBtn.Text = "✅  Applied!"
        task.delay(1, function()
            if ApplyBtn.Parent then ApplyBtn.Text = "⚡  Hook — apply always" end
        end)
    end)
end

