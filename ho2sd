--==============================================================
-- RENDER LOOP — обновление счётчиков
--==============================================================
ClearBtn.MouseButton1Click:Connect(function()
    EventLog = {}
    EventOrder = {}
    for name, card in pairs(eventCards) do
        if card then card:Destroy() end
    end
    eventCards = {}
end)

task.spawn(function()
    while ScreenGui.Parent do
        for _, name in ipairs(EventOrder) do
            local entry = EventLog[name]
            if entry and not C.hidden[name] then
                local card = eventCards[name]
                if not card or not card.Parent then
                    -- Удалена вручную или новая
                    eventCards[name] = nil
                    card = createEventCard(entry)
                end
                -- Обновляем счётчик
                if card then
                    for _, c in ipairs(card:GetDescendants()) do
                        if c:IsA("TextLabel") and c.Text:match("^×%d+") then
                            c.Text = "×" .. entry.count
                            break
                        end
                    end
                    -- Обновляем превью (аргументы последнего вызова)
                    for _, c in ipairs(card:GetDescendants()) do
                        if c:IsA("TextLabel") and c.Text:match("^%{") then
                            c.Text = shortPreview(entry.args, 120)
                            break
                        end
                    end
                end
            end
        end
        task.wait(0.4)
    end
end)

