local function updateEventCard(entry, card)
    if not card or not card.Parent then return end
    local badge = card:FindFirstChildWhichIsA("Frame", true)
    -- Ищем CountLbl
    for _, c in ipairs(card:GetDescendants()) do
        if c:IsA("TextLabel") and c.Text:match("^×%d+") then
            c.Text = "×" .. entry.count
            break
        end
    end
end

