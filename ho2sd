        lbl.TextColor3 = C.accent
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 23

        local boxWrap = Instance.new("Frame", wrap)
        boxWrap.Size = UDim2.new(1, 0, 0, 34)
        boxWrap.Position = UDim2.new(0, 0, 0, 24)
        boxWrap.BackgroundColor3 = C.input
        boxWrap.BorderSizePixel = 0
        boxWrap.ZIndex = 23
        corner(boxWrap, 7)
        local bs = stroke(boxWrap, C.border, 1, 0.3)

        local box = Instance.new("TextBox", boxWrap)
        box.Size = UDim2.new(1, -20, 1, 0)
        box.Position = UDim2.new(0, 10, 0, 0)
        box.BackgroundTransparency = 1
        box.Text = serialize(initialValue)
        box.TextColor3 = C.text
        box.TextTransparency = 1
        box.Font = Enum.Font.Code
        box.TextSize = 13
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.ClearTextOnFocus = false
        box.ZIndex = 25

        local hl = Instance.new("TextLabel", boxWrap)
        hl.Size = UDim2.new(1, -20, 1, 0)
        hl.Position = UDim2.new(0, 10, 0, 0)
        hl.BackgroundTransparency = 1
        hl.RichText = true
        hl.Text = colorize(box.Text)
        hl.Font = Enum.Font.Code
        hl.TextSize = 13
        hl.TextXAlignment = Enum.TextXAlignment.Left
        hl.ZIndex = 24

        box:GetPropertyChangedSignal("Text"):Connect(function()
            hl.Text = colorize(box.Text)
            if onChanged then onChanged(box.Text) end
        end)
        box.Focused:Connect(function()
            bs.Color = C.accent; bs.Thickness = 1.5
            box.TextTransparency = 0; hl.TextTransparency = 1
        end)
        box.FocusLost:Connect(function()
            bs.Color = C.border; bs.Thickness = 1
            box.TextTransparency = 1; hl.TextTransparency = 0
            if onChanged then onChanged(box.Text) end
        end)
    end

    local function buildArgCard(parent, index, value)
        local card = Instance.new("Frame", parent)
        card.Size = UDim2.new(1, -8, 0, 0)
        card.AutomaticSize = Enum.AutomaticSize.Y
        card.BackgroundColor3 = C.surface2
        card.BorderSizePixel = 0
        card.ZIndex = 204
        card.LayoutOrder = index
        corner(card, 9)
        pad(card, 12, 12, 14, 14)
        vlist(card, 8)

        local header = Instance.new("TextLabel", card)
        header.Size = UDim2.new(1, 0, 0, 16)
        header.BackgroundTransparency = 1
        header.Text = "ARGUMENT #" .. index
        header.TextColor3 = C.accent
        header.Font = Enum.Font.GothamBold
        header.TextSize = 11
        header.TextXAlignment = Enum.TextXAlignment.Left
        header.ZIndex = 205
        header.LayoutOrder = 1

        if type(value) == "table" then
            local keys = {}
            for k in pairs(value) do table.insert(keys, k) end
            table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
            local sub = Instance.new("Frame", card)
            sub.Size = UDim2.new(1, 0, 0, 0)
            sub.AutomaticSize = Enum.AutomaticSize.Y
            sub.BackgroundColor3 = C.surface
            sub.BorderSizePixel = 0
            sub.ZIndex = 205
            sub.LayoutOrder = 2
            corner(sub, 8)
            pad(sub, 10, 10, 12, 12)
            vlist(sub, 8)
            local subTable = {}
            for _, k in ipairs(keys) do subTable[k] = value[k] end
            draft[index] = subTable
            for order, k in ipairs(keys) do
                local labelText = type(k) == "string" and k or ("[" .. tostring(k) .. "]")
                makeField(sub, order, labelText, value[k], function(txt)
                    draft[index][k] = parseValue(txt)
                    C.drafts[entry.name] = draft
                end)
            end
        else
            draft[index] = value
            makeField(card, 2, "value", value, function(txt)
                draft[index] = parseValue(txt)
                C.drafts[entry.name] = draft
            end)
        end
    end

    for i, arg in ipairs(sourceArgs) do
        buildArgCard(ArgScroll, i, arg)
    end

    local SaveBtn = Instance.new("TextButton", EditorWindow)
    SaveBtn.Size = UDim2.new(0.5, -18, 0, 46)
