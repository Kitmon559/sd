local function getAllRemotes()
    local remotes, seen = {}, {}
    local function scan(container, path)
        if not container then return end
        local ok, children = pcall(function() return container:GetChildren() end)
        if not ok then return end
        for _, child in ipairs(children) do
            if seen[child] then continue end
            seen[child] = true
            local cls = child.ClassName
            if cls == "RemoteEvent" or cls == "RemoteFunction"
               or cls == "UnreliableRemoteEvent" or cls == "BindableEvent"
               or cls == "BindableFunction" then
                table.insert(remotes, {
                    name = child.Name,
                    path = path .. "/" .. child.Name,
                    class = cls,
                    instance = child,
                })
            end
            if cls == "Folder" or cls == "Model" or cls == "Actor" or cls == "Configuration" then
                scan(child, path .. "/" .. child.Name)
            end
        end
    end
    scan(RS, "ReplicatedStorage")
    scan(workspace, "Workspace")
    scan(game:GetService("ReplicatedFirst"), "ReplicatedFirst")
    scan(game:GetService("StarterGui"), "StarterGui")
    scan(game:GetService("StarterPack"), "StarterPack")
    scan(game:GetService("Players"), "Players")
    local lp = Players.LocalPlayer
    if lp then
        scan(lp, "LocalPlayer")
        scan(lp:FindFirstChild("PlayerGui"), "LocalPlayer.PlayerGui")
        scan(lp:FindFirstChild("PlayerScripts"), "LocalPlayer.PlayerScripts")
        scan(lp:FindFirstChild("Backpack"), "LocalPlayer.Backpack")
    end
    return remotes
end

--==============================================================
-- HOOK — группировка по имени
--==============================================================
-- EventLog: [remoteName] = { name, method, args, count, firstTime, lastTime, className }
local EventLog = {}
local EventOrder = {}   -- порядок появления имён (свежие первыми)
local MAX_LOG = 200
local lastByRemote = {}

local origNamecall
origNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local args = table.pack(...)
    local method = getnamecallmethod()
    local m = method:lower()

    local toServer = (m == "fireserver" or m == "invokeserver"
                      or m == "fire" or m == "invoke"
                      or m == "sendmessage")

    if C.debugMode and typeof(self) == "Instance" then
        pcall(function()
            local rName = self.Name
            local now = os.clock()
            if not lastByRemote["DBG_" .. rName] or now - lastByRemote["DBG_" .. rName] > 0.5 then
                lastByRemote["DBG_" .. rName] = now
                local entry = EventLog[rName]
                if entry then
                    entry.count = entry.count + 1
                    entry.lastTime = now
                    entry.method = m
                    entry.args = args
                else
                    EventLog[rName] = {
                        name = rName, method = m, args = args,
                        count = 1, firstTime = now, lastTime = now,
                        className = typeof(self) == "Instance" and self.ClassName or "?",
                        debug = true,
                    }
                    table.insert(EventOrder, 1, rName)
                    if #EventOrder > MAX_LOG then
                        local removed = table.remove(EventOrder)
                        EventLog[removed] = nil
                    end
                end
            end
        end)
    end

    if toServer then
        local rName = (typeof(self) == "Instance") and self.Name or nil

        if rName and C.blocked[rName] then
            return
        end

        if rName and not C.hidden[rName] then
            local now = os.clock()
            if not lastByRemote[rName] or now - lastByRemote[rName] > 0.1 then
                lastByRemote[rName] = now
                local entry = EventLog[rName]
                if entry then
                    entry.count = entry.count + 1
                    entry.lastTime = now
                    entry.method = m
                    entry.args = args
                else
                    EventLog[rName] = {
                        name = rName, method = m, args = args,
                        count = 1, firstTime = now, lastTime = now,
                        className = typeof(self) == "Instance" and self.ClassName or "?",
                    }
                    table.insert(EventOrder, 1, rName)
                    if #EventOrder > MAX_LOG then
                        local removed = table.remove(EventOrder)
                        EventLog[removed] = nil
                    end
                end
            end
        end

        if C.enabled and rName and C.rules[rName] and C.rules[rName].enabled then
            local rule = C.rules[rName]
            local newArgs = {}
            local count = math.max(args.n, #rule.args)
            for i = 1, count do
                newArgs[i] = rule.args[i] ~= nil and rule.args[i] or args[i]
            end
            return origNamecall(self, unpack(newArgs, 1, count))
        end
    end

    return origNamecall(self, unpack(args, 1, args.n))
end))

