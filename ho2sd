--==============================================================
-- TAB SWITCHING
--==============================================================
local function setTab(tab)
    local all = {
        {EventsTabBtn, EventsPage},
        {HooksTabBtn, HooksPage},
        {SettingsTabBtn, SettingsPage},
        {ScannerTabBtn, ScannerPage},
    }
    for _, pair in ipairs(all) do
        pair[1].BackgroundColor3 = C.surface
        pair[1].TextColor3 = C.textDim
        pair[2].Visible = false
    end
    if tab == "events" then
        EventsTabBtn.BackgroundColor3 = C.accent
        EventsTabBtn.TextColor3 = C.text
        EventsPage.Visible = true
    elseif tab == "hooks" then
        HooksTabBtn.BackgroundColor3 = C.accent
        HooksTabBtn.TextColor3 = C.text
        HooksPage.Visible = true
        refreshHooksList()
    elseif tab == "settings" then
        SettingsTabBtn.BackgroundColor3 = C.accent
        SettingsTabBtn.TextColor3 = C.text
        SettingsPage.Visible = true
        refreshSettingsList()
    elseif tab == "scanner" then
        ScannerTabBtn.BackgroundColor3 = C.accent
        ScannerTabBtn.TextColor3 = C.text
        ScannerPage.Visible = true
        refreshScannerList()
    end
end

EventsTabBtn.MouseButton1Click:Connect(function() setTab("events") end)
