-- Состояния
local particlesDisabled = false
local texturesSimplified = false
local lightRemoved = false
local playersSimplified = false
local noCollisionHidden = false
local shadowsRemoved = false
local decalsRemoved = false
local textureHuntActive = false   -- режим "удалять текстуры у всего, кроме игроков"
local menuVisible = true

-- Хранилища
local originalProperties = {}
local originalLighting = {}
local originalLights = {}
local originalPlayerState = {}
local originalDecals = {}
local hiddenNoCollision = {}
local originalShadowProps = {}

-- ===== ПАРТИКЛЫ =====
local function RemoveParticles(object)
    if object:IsA("ParticleEmitter") then object.Enabled = false end
end

-- ===== ПРОСТЫЕ ТЕКСТУРЫ (обратимо) =====
local function SimplifyTexture(object)
    if object:IsA("BasePart") then
        if not originalProperties[object] then
            originalProperties[object] = { Material = object.Material }
        end
        pcall(function() object.Material = Enum.Material.Plastic end)
    end
end

local function RestoreTexture(object)
    if object:IsA("BasePart") and originalProperties[object] then
        pcall(function() object.Material = originalProperties[object].Material end)
        originalProperties[object] = nil
    end
end

-- ===== СВЕТ =====
local function SaveOriginalLight(light)
    if not originalLights[light] then
        originalLights[light] = {
            Brightness = light.Brightness, Color = light.Color,
            Enabled = light.Enabled, Range = light.Range, Shadows = light.Shadows
        }
    end
end

local function RemoveLight()
    originalLighting = {
        Ambient = game.Lighting.Ambient,
        OutdoorAmbient = game.Lighting.OutdoorAmbient,
        Brightness = game.Lighting.Brightness,
        ClockTime = game.Lighting.ClockTime,
        GlobalShadows = game.Lighting.GlobalShadows,
        ExposureCompensation = game.Lighting.ExposureCompensation
    }
    game.Lighting.Ambient = Color3.fromRGB(0, 0, 0)
    game.Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
    game.Lighting.Brightness = 0
    game.Lighting.GlobalShadows = false
    game.Lighting.ExposureCompensation = 0
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Light") then
            SaveOriginalLight(v)
            v.Enabled = false
        end
    end
end

local function RestoreLight()
    if originalLighting.Ambient then
        game.Lighting.Ambient = originalLighting.Ambient
        game.Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        game.Lighting.Brightness = originalLighting.Brightness
        game.Lighting.ClockTime = originalLighting.ClockTime
        game.Lighting.GlobalShadows = originalLighting.GlobalShadows
        game.Lighting.ExposureCompensation = originalLighting.ExposureCompensation
    end
    for light, props in pairs(originalLights) do
        if light and light.Parent then
            light.Brightness = props.Brightness
            light.Color = props.Color
            light.Enabled = props.Enabled
            light.Range = props.Range
            light.Shadows = props.Shadows
        end
    end
    originalLights = {}
end

-- ===== УПРОЩЕНИЕ ИГРОКОВ =====
local function IsInsideCharacter(obj)
    local char = game.Players.LocalPlayer.Character
    -- проверяем, что объект принадлежит какому-либо персонажу
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr.Character and obj:IsDescendantOf(plr.Character) then
            return true
        end
    end
    return false
end

local function SimplifyPlayer(player)
    if not player or not player.Character then return end
    if player == game.Players.LocalPlayer then return end
    local char = player.Character
    local state = originalPlayerState[player]
    if not state then
        state = { hiddenParts = {}, hiddenDecals = {}, clothing = {}, bodyMats = {} }
        originalPlayerState[player] = state
    end

    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.Parent and v.Parent:IsA("Accessory") then
            if state.hiddenParts[v] == nil then state.hiddenParts[v] = v.Transparency end
            v.Transparency = 1
            v.CanCollide = false
        end
        if v:IsA("Decal") or v:IsA("Texture") then
            if state.hiddenDecals[v] == nil then state.hiddenDecals[v] = v.Transparency end
            v.Transparency = 1
        end
        if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
            local exists = false
            for _, e in ipairs(state.clothing) do
                if e.obj == v then exists = true break end
            end
            if not exists then
                table.insert(state.clothing, { obj = v, texture = v.Texture })
            end
            pcall(function() v.Texture = "" end)
        end
        if v:IsA("BasePart") and (v.Name == "Head" or v.Name == "Torso"
            or v.Name:find("Arm") or v.Name:find("Leg")
            or v.Name == "HumanoidRootPart") then
            if not state.bodyMats[v] then
                state.bodyMats[v] = { Material = v.Material, Color = v.Color }
            end
            pcall(function()
                v.Material = Enum.Material.SmoothPlastic
                v.Color = Color3.fromRGB(120, 120, 120)
            end)
        end
    end
end

local function RestorePlayer(player)
    local state = originalPlayerState[player]
    if not state then return end
    for part, t in pairs(state.hiddenParts) do
        if part and part.Parent then pcall(function() part.Transparency = t end) end
    end
    for decal, t in pairs(state.hiddenDecals) do
        if decal and decal.Parent then pcall(function() decal.Transparency = t end) end
    end
    for _, e in ipairs(state.clothing) do
        if e.obj and e.obj.Parent then
            pcall(function() e.obj.Texture = e.texture end)
        end
    end
    for part, mats in pairs(state.bodyMats) do
        if part and part.Parent then
            pcall(function()
                part.Material = mats.Material
                part.Color = mats.Color
            end)
        end
    end
    originalPlayerState[player] = nil
end

local function SimplifyAllPlayers()
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= game.Players.LocalPlayer then SimplifyPlayer(plr) end
    end
end

local function RestoreAllPlayers()
    for plr, _ in pairs(originalPlayerState) do
        RestorePlayer(plr)
    end
end

-- ===== СКРЫТИЕ БЕЗ КОЛЛИЗИИ =====
local function HideNoCollision()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v.CanCollide and v.Name ~= "HumanoidRootPart" then
            if not IsInsideCharacter(v) then
                if hiddenNoCollision[v] == nil then hiddenNoCollision[v] = v.Transparency end
                v.Transparency = 1
            end
        end
    end
end

local function RestoreNoCollision()
    for obj, t in pairs(hiddenNoCollision) do
        if obj and obj.Parent then pcall(function() obj.Transparency = t end) end
    end
    hiddenNoCollision = {}
end

-- ===== ТЕНИ =====
local function RemoveShadows()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            if originalShadowProps[v] == nil then originalShadowProps[v] = v.CastShadow end
            v.CastShadow = false
        end
    end
end

local function RestoreShadows()
    for obj, cs in pairs(originalShadowProps) do
        if obj and obj.Parent then pcall(function() obj.CastShadow = cs end) end
    end
    originalShadowProps = {}
end

-- ===== ДЕКАЛИ (обратимо) =====
local function RemoveDecals()
    for _, v in pairs(workspace:GetDescendants()) do
        if (v:IsA("Decal") or v:IsA("Texture")) and not IsInsideCharacter(v) then
            if originalDecals[v] == nil then originalDecals[v] = v.Transparency end
            v.Transparency = 1
        end
    end
end

local function RestoreDecals()
    for obj, t in pairs(originalDecals) do
        if obj and obj.Parent then pcall(function() obj.Transparency = t end) end
    end
    originalDecals = {}
end

-- ===== ОХОТА ЗА ТЕКСТУРАМИ (необратимо для НЕ-игроков) =====
-- Удаляет Decal/Texture/SurfaceAppearance и Material = Plastic у всего,
-- кроме персонажей игроков. Работает постоянно, пока режим включён.
local function HuntTexturesIn(object)
    if not object or not object.Parent then return end
    -- Не трогаем персонажей игроков
    if IsInsideCharacter(object) then return end

    if object:IsA("Decal") or object:IsA("Texture") or object:IsA("SurfaceAppearance") then
        pcall(function() object:Destroy() end)
        return
    end

    if object:IsA("BasePart") then
        pcall(function()
            object.Material = Enum.Material.Plastic
            if object:IsA("MeshPart") then
                object.TextureID = ""
            end
        end)
    end
end

local function HuntAllTextures()
    -- Проходим по всем потомкам workspace и Lighting
    for _, v in pairs(workspace:GetDescendants()) do
        HuntTexturesIn(v)
    end
end

-- ===== ПРОЦЕСС =====
local function ProcessAllObjects()
    if textureHuntActive then HuntAllTextures() end
    for _, v in pairs(workspace:GetDescendants()) do
        if particlesDisabled then RemoveParticles(v) end
        if texturesSimplified and not textureHuntActive then SimplifyTexture(v) end
    end
    if lightRemoved then RemoveLight() end
    if playersSimplified then SimplifyAllPlayers() end
    if noCollisionHidden then HideNoCollision() end
    if shadowsRemoved then RemoveShadows() end
    if decalsRemoved then RemoveDecals() end
end

-- ===== НОВЫЕ ОБЪЕКТЫ =====
workspace.DescendantAdded:Connect(function(descendant)
    task.wait(0.1)
    if not descendant or not descendant.Parent then return end

    -- Охота на текстуры (работает всегда, пока активна)
    if textureHuntActive then
        HuntTexturesIn(descendant)
        -- Если у BasePart есть дети-текстуры, удалим и их
        for _, child in pairs(descendant:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") or child:IsA("SurfaceAppearance") then
                if not IsInsideCharacter(child) then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end

    if particlesDisabled then RemoveParticles(descendant) end
    if texturesSimplified and not textureHuntActive then SimplifyTexture(descendant) end
    if lightRemoved and descendant:IsA("Light") then
        SaveOriginalLight(descendant)
        descendant.Enabled = false
    end
    if noCollisionHidden and descendant:IsA("BasePart") and not descendant.CanCollide then
        if not IsInsideCharacter(descendant) then
            hiddenNoCollision[descendant] = descendant.Transparency
            descendant.Transparency = 1
        end
    end
    if shadowsRemoved and descendant:IsA("BasePart") then
        originalShadowProps[descendant] = descendant.CastShadow
        descendant.CastShadow = false
    end
    if decalsRemoved and (descendant:IsA("Decal") or descendant:IsA("Texture")) then
        if not IsInsideCharacter(descendant) then
            originalDecals[descendant] = descendant.Transparency
            descendant.Transparency = 1
        end
    end
end)

-- Дополнительно: подчищаем текстуры у новых объектов, добавленных внутрь частей
workspace.DescendantAdded:Connect(function(descendant)
    if textureHuntActive and (descendant:IsA("Decal") or descendant:IsA("Texture") or descendant:IsA("SurfaceAppearance")) then
        task.wait(0.05)
        if descendant and descendant.Parent and not IsInsideCharacter(descendant) then
            pcall(function() descendant:Destroy() end)
        end
    end
end)

