-- Появление снизу
mainFrame.Position = UDim2.new(0.5, 0, 1, 60)
local appearTween = TweenService:Create(
    mainFrame,
    TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Position = UDim2.new(0.5, 0, 1, -20) }
)
appearTween:Play()

-- Пульсация иконки
task.spawn(function()
    while mainFrame.Parent do
        local pulse = TweenService:Create(
            iconLabel,
            TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { TextColor3 = Color3.fromRGB(255, 220, 130), TextSize = 26 }
        )
        pulse:Play()
        pulse.Completed:Wait()
        local back = TweenService:Create(
            iconLabel,
            TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { TextColor3 = Color3.fromRGB(200, 160, 255), TextSize = 22 }
        )
        back:Play()
        back.Completed:Wait()
    end
end)

-- Исчезновение через 3 секунды
task.delay(3, function()
    local disappearTween = TweenService:Create(
        mainFrame,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = UDim2.new(0.5, 0, 1, 70) }
    )
    disappearTween:Play()
    disappearTween.Completed:Wait()
    screenGui:Destroy()
end)
