-- Появление справа
local appearTween = TweenService:Create(
    mainFrame,
    TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Position = UDim2.new(1, -12, 1, -12) }
)
appearTween:Play()

-- Пульсация иконки
task.spawn(function()
    while mainFrame.Parent do
        local pulse = TweenService:Create(
            iconLabel,
            TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { TextColor3 = Color3.fromRGB(255, 220, 130), TextSize = 21 }
        )
        pulse:Play()
        pulse.Completed:Wait()
        local back = TweenService:Create(
            iconLabel,
            TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { TextColor3 = Color3.fromRGB(200, 160, 255), TextSize = 18 }
        )
        back:Play()
        back.Completed:Wait()
    end
end)

-- Постоянная проверка Glitch Level каждые 0.1 сек
local lastValue = nil
task.spawn(function()
    while mainFrame.Parent do
        local currentValue = getGlitchLevel(player)
        
        if currentValue ~= lastValue then
            lastValue = currentValue
            
            if currentValue then
                valueLabel.Text = "Glitch: " .. tostring(currentValue)
                valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                
                -- Лёгкая вспышка при обновлении значения
                valueLabel.TextColor3 = Color3.fromRGB(255, 220, 130)
                TweenService:Create(
                    valueLabel,
                    TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { TextColor3 = Color3.fromRGB(255, 255, 255) }
                ):Play()
            else
                valueLabel.Text = "Glitch: N/A"
                valueLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
            end
        end
        
        task.wait(0.1)
    end
end)

-- Функция закрытия
local closed = false
local function closeMenu()
    if closed then return end
    closed = true
    
    local disappearTween = TweenService:Create(
        mainFrame,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = UDim2.new(1, 200, 1, -12) }
    )
    disappearTween:Play()
    disappearTween.Completed:Wait()
    screenGui:Destroy()
end

-- Закрытие только по клавише ]
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightBracket then
        closeMenu()
    end
end)
