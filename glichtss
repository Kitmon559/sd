-- LocalScript (поместить в StarterPlayerScripts или StarterGui)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Функция получения Glitch Level
local function getGlitchLevel(plr)
    if plr:FindFirstChild("leaderstats") then
        local glitch = plr.leaderstats:FindFirstChild("Glitch Level") 
            or plr.leaderstats:FindFirstChild("GlitchLevel")
            or plr.leaderstats:FindFirstChild("Glitch")
        if glitch then return glitch.Value end
    end
    
    local attr = plr:GetAttribute("GlitchLevel") or plr:GetAttribute("Glitch Level")
    if attr then return attr end
    
    local stats = plr:FindFirstChild("Stats") or plr:FindFirstChild("Data")
    if stats then
        local glitch = stats:FindFirstChild("GlitchLevel") or stats:FindFirstChild("Glitch Level")
        if glitch then return glitch.Value end
    end
    
    return nil
end

