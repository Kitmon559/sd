local function buildLines(root)
    local out = {}
    local function walk(tbl, prefix, depth)
        if depth > 4 then return end
        if type(tbl) ~= "table" then return end
        for k, v in pairs(tbl) do
            local key = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k or ("[" .. tostring(k) .. "]")
            local full = (prefix == "" and key) or (prefix .. "." .. key)
            local vt = typeof(v)
            if vt == "table" then
                table.insert(out, {key = full, raw = "{...}", isTable = true})
                walk(v, full, depth + 1)
            else
                table.insert(out, {key = full, raw = pretty(v), isTable = false})
            end
        end
    end
    walk(root, "", 0)
    return out
end

