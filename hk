                Instance.new("UICorner", box).CornerRadius = UDim.new(0, 3)
                local bp = Instance.new("UIPadding", box)
                bp.PaddingLeft = UDim.new(0, 4); bp.PaddingRight = UDim.new(0, 4)

                -- подсветка
                box.RichText = true
                box.Text = highlightLuaFixed(full)

                box.Focused:Connect(function()
                    box.RichText = false
                    box.Text = full
                    box.BackgroundTransparency = 0.3
                end)

                box.FocusLost:Connect(function(enter)
                    box.BackgroundTransparency = 0.7
                    local newText = box.Text
                    if newText ~= full then
                        local k, v = newText:match("^(.-)%s*=%s*(.+)$")
                        if k and v then
                            k = k:gsub("%s+$", ""); v = v:gsub("^%s+", ""):gsub("%s+$", "")
                            local value, perr = parseValue(v)
                            if value == nil and perr then
                                box.TextColor3 = THEME.bad
                                task.delay(0.6, function() box.TextColor3 = THEME.text end)
                                log("❌ " .. perr, THEME.bad)
                            else
                                local ok, err = setByPath(currentTarget, k, value)
                                if ok then
                                    entry.raw = v; entry.key = k
                                    full = k .. " = " .. v
                                    box.TextColor3 = THEME.good
                                    task.delay(0.6, function() box.TextColor3 = THEME.text end)
                                    log("✅ " .. k .. " = " .. v, THEME.good)
                                else
                                    box.TextColor3 = THEME.bad
                                    task.delay(0.6, function() box.TextColor3 = THEME.text end)
                                    log("❌ " .. tostring(err), THEME.bad)
                                end
                            end
                        end
                    end
                    -- возвращаем подсветку
                    box.RichText = true
                    box.Text = highlightLuaFixed(full)
                end)
            end
        end
    end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(rebuildCodeView)

-- ============================================================
--  ОТКРЫТИЕ РЕДАКТОРА
-- ============================================================
viewBtn.MouseButton1Click:Connect(function()
    local path = pathBox.Text
    if path == "" then log("❌ Введи путь", THEME.bad); return end
    log("⏳ Ищу: " .. path, THEME.accent)
    local target, err = resolvePath(path)
    if not target then log("❌ " .. tostring(err), THEME.bad); return end

    if typeof(target) == "Instance" and target:IsA("ModuleScript") then
        local ok, mod = pcall(require, target)
        if not ok then log("❌ require: " .. tostring(mod), THEME.bad); return end
        target = mod
    end

    currentTarget = target
    lines = buildLines(target)
    rebuildCodeView()

    main.Visible = false
    editor.Visible = true
    log("✅ Открыто: " .. #lines .. " строк", THEME.good)
end)

-- ============================================================
--  КНОПКИ ТУЛБАРА
-- ============================================================
makeToolBtn("📋 Copy", THEME.panelAlt, function()
    local txt = {}
    for _, l in ipairs(lines) do table.insert(txt, l.key .. " = " .. l.raw) end
    local full = table.concat(txt, "\n")
    if setclipboard then setclipboard(full); log("📋 Скопировано", THEME.good)
    else log("❌ Нет setclipboard", THEME.bad) end
end)

makeToolBtn("💾 Save", Color3.fromRGB(55, 90, 70), function()
    if not currentTarget then log("❌ Нет цели", THEME.bad); return end
    local okCount, failCount = 0, 0
    for _, l in ipairs(lines) do
        if not l.isTable then
            local value, perr = parseValue(l.raw)
            if value == nil and perr then
                failCount = failCount + 1
                log("❌ " .. l.key .. ": " .. perr, THEME.bad)
            else
                local ok, err = setByPath(currentTarget, l.key, value)
                if ok then okCount = okCount + 1
                else
                    failCount = failCount + 1
                    log("❌ " .. l.key .. ": " .. tostring(err), THEME.bad)
                end
            end
        end
    end
    log(string.format("💾 Сохранено: %d ок, %d ошибок", okCount, failCount),
        failCount == 0 and THEME.good or THEME.warn)
end)

makeToolBtn("🗑 Clear", Color3.fromRGB(90, 55, 55), function()
    lines = {}
    rebuildCodeView()
    log("🗑 Очищено", THEME.warn)
end)

-- ============================================================
--  G — открыть/закрыть
-- ============================================================
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.G then
        if editor.Visible then
            editor.Visible = false; main.Visible = true
        elseif main.Visible then
            main.Visible = false
        else
            main.Visible = true
        end
    end
end)

