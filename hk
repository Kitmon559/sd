local function resolvePath(path)
    path = path:gsub('game:GetService%s*%(%s*["\']([%w_]+)["\']%s*%)', 'game.%1')
    path = path:gsub("^game%.", "")

    local current = game
    for part in path:gmatch("[^%.]+") do
        local name, idx = part:match("^([%w_]+)%[(%d+)%]$")
        if name then
            if current == nil then return nil, "обрыв на " .. name end
            current = current[name]
            if current == nil then return nil, "нет поля " .. name end
            current = current[tonumber(idx)]
        else
            if current == nil then return nil, "обрыв на " .. part end
            local ok, next_ = pcall(function() return current[part] end)
            if not ok or next_ == nil then
                if typeof(current) == "Instance" then
                    local found = current:FindFirstChild(part)
                    if found then next_ = found else return nil, "нет поля " .. part end
                else
                    return nil, "нет поля " .. part
                end
            end
            current = next_
        end
    end
    return current
end

local function pretty(v, indent, seen)
    indent = indent or 0
    seen = seen or {}
    local pad = string.rep("  ", indent)
    local t = typeof(v)
    if t == "Instance" then
        return v:GetFullName()
    elseif t == "Color3" then
        return string.format("Color3.fromRGB(%d, %d, %d)", v.R*255, v.G*255, v.B*255)
    elseif t == "Vector3" then
        return string.format("Vector3.new(%g, %g, %g)", v.X, v.Y, v.Z)
    elseif t == "UDim2" then
        return string.format("UDim2.new(%g, %d, %g, %d)", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
    elseif t == "EnumItem" then
        return tostring(v)
    elseif t == "table" then
        if seen[v] then return "<cycle>" end
        seen[v] = true
        local parts = {}
        for k, val in pairs(v) do
            local key = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k or ("[" .. tostring(k) .. "]")
            table.insert(parts, pad .. "  " .. key .. " = " .. pretty(val, indent + 1, seen))
        end
        seen[v] = nil
        if #parts == 0 then return "{}" end
        return "{\n" .. table.concat(parts, ",\n") .. "\n" .. pad .. "}"
    elseif t == "string" then
        return string.format("%q", v)
    else
        return tostring(v)
    end
end

