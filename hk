local function parseValue(str)
    if type(str) ~= "string" then return nil, "не строка" end
    str = str:gsub("^%s+", ""):gsub("%s+$", "")
    str = str:gsub(",%s*$", "")

    if str == "nil" then return nil end

    -- строка
    local s = str:match('^"(.*)"$') or str:match("^'(.*)'$")
    if s then
        -- unescape
        s = s:gsub('\\"', '"'):gsub("\\'", "'"):gsub("\\n", "\n"):gsub("\\\\", "\\")
        return s
    end

    -- bool
    if str == "true" then return true end
    if str == "false" then return false end

    -- число
    local n = tonumber(str)
    if n then return n end

    -- Color3.fromRGB(r,g,b)
    do
        local r, g, b = str:match("Color3%.fromRGB%s*%(%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*%)")
        if r then return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) end
    end

    -- Color3.new(r,g,b)
    do
        local r, g, b = str:match("Color3%.new%s*%(%s*([%d%.]+)%s*,%s*([%d%.]+)%s*,%s*([%d%.]+)%s*%)")
        if r then return Color3.new(tonumber(r), tonumber(g), tonumber(b)) end
    end

    -- Vector3.new(x,y,z)
    do
        local x, y, z = str:match("Vector3%.new%s*%(%s*([%-%d%.eE]+)%s*,%s*([%-%d%.eE]+)%s*,%s*([%-%d%.eE]+)%s*%)")
        if x then return Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
    end

    -- UDim2.new(xs,xo,ys,yo)
    do
        local xs, xo, ys, yo = str:match("UDim2%.new%s*%(%s*([%-%d%.]+)%s*,%s*([%-%d]+)%s*,%s*([%-%d%.]+)%s*,%s*([%-%d]+)%s*%)")
        if xs then
            return UDim2.new(tonumber(xs), tonumber(xo), tonumber(ys), tonumber(yo))
        end
    end

    -- Enum.X.Y
    do
        local a, b = str:match("Enum%.([%w_]+)%.([%w_]+)")
        if a then
            local ok, item = pcall(function() return Enum[a][b] end)
            if ok then return item end
        end
    end

    return nil, "неизвестный тип: " .. str
end

-- Установка значения по пути
local function setByPath(root, path, value)
    local parts = {}
    for part in path:gmatch("[^%.]+") do
        local name, idx = part:match("^([%w_]+)%[(%d+)%]$")
        if name then
            table.insert(parts, name)
            table.insert(parts, tonumber(idx))
        else
            table.insert(parts, part)
        end
    end

    local cur = root
    for i = 1, #parts - 1 do
        if cur == nil then return false, "обрыв на " .. tostring(parts[i]) end
        cur = cur[parts[i]]
    end
    if cur == nil then return false, "не найдено" end
    cur[parts[#parts]] = value
    return true
end

