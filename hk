        table.insert(out, string.format('<font color="rgb(%d,%d,%d)">%s</font>',
            color.R*255, color.G*255, color.B*255, esc(text)))
    end

    while i <= n do
        local c = code:sub(i, i)
        local rest = code:sub(i)

        local cmt = rest:match("^(%-%-[^\n]*)")
        if cmt then push(cmt, THEME.comment); i = i + #cmt
        elseif c == '"' or c == "'" then
            local str = rest:match('^' .. c .. '([^' .. c .. '\\]*)' .. c)
            if str then
