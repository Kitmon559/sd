local function makeField(parent, layoutOrder, labelText, initialValue, onChanged)
    local wrap = Instance.new("Frame", parent)
    wrap.Size = UDim2.new(1, 0, 0, 58)
    wrap.BackgroundColor3 = C.surface2
    wrap.BorderSizePixel = 0
    wrap.LayoutOrder = layoutOrder
    wrap.ZIndex = 22
    corner(wrap, 8)
    pad(wrap, 6, 6, 10, 10)

    local lbl = Instance.new("TextLabel", wrap)
    lbl.Size = UDim2.new(1, 0, 0, 14)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = C.accent
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 23

    local boxWrap = Instance.new("Frame", wrap)
    boxWrap.Size = UDim2.new(1, 0, 0, 30)
    boxWrap.Position = UDim2.new(0, 0, 0, 22)
    boxWrap.BackgroundColor3 = C.input
    boxWrap.BorderSizePixel = 0
    boxWrap.ZIndex = 23
    corner(boxWrap, 6)
    local bs = stroke(boxWrap, C.border, 1, 0.3)

    local box = Instance.new("TextBox", boxWrap)
    box.Size = UDim2.new(1, -16, 1, 0)
    box.Position = UDim2.new(0, 8, 0, 0)
    box.BackgroundTransparency = 1
    box.Text = serialize(initialValue)
    box.TextColor3 = C.text
    box.TextTransparency = 1
    box.Font = Enum.Font.Code
    box.TextSize = 12
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ClearTextOnFocus = false
    box.ZIndex = 25

    local hl = Instance.new("TextLabel", boxWrap)
    hl.Size = UDim2.new(1, -16, 1, 0)
    hl.Position = UDim2.new(0, 8, 0, 0)
    hl.BackgroundTransparency = 1
    hl.RichText = true
    hl.Text = colorize(box.Text)
    hl.Font = Enum.Font.Code
    hl.TextSize = 12
    hl.TextXAlignment = Enum.TextXAlignment.Left
    hl.ZIndex = 24

    box:GetPropertyChangedSignal("Text"):Connect(function()
        hl.Text = colorize(box.Text)
        if onChanged then onChanged(box.Text) end
    end)
    box.Focused:Connect(function()
        bs.Color = C.accent
        bs.Thickness = 1.5
        box.TextTransparency = 0
        hl.TextTransparency = 1
    end)
    box.FocusLost:Connect(function()
        bs.Color = C.border
        bs.Thickness = 1
        box.TextTransparency = 1
        hl.TextTransparency = 0
        if onChanged then onChanged(box.Text) end
    end)
end

