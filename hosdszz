--==============================================================
-- SERIALIZE / PARSE
--==============================================================
local function serialize(v, seen)
    seen = seen or {}
    local t = type(v)
    if t == "string" then return string.format("%q", v)
    elseif t == "number" or t == "boolean" then return tostring(v)
    elseif t == "nil" then return "nil"
    elseif t == "table" then
        if seen[v] then return "--[[cycle]]" end
        seen[v] = true
        local keys, isArray = {}, true
        for k in pairs(v) do
            table.insert(keys, k)
            if type(k) ~= "number" then isArray = false end
        end
        table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
        local parts = {}
        if isArray then
            for _, k in ipairs(keys) do
                table.insert(parts, serialize(v[k], seen))
            end
        else
            for _, k in ipairs(keys) do
                local key = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k
                            or ("[" .. serialize(k, seen) .. "]")
                table.insert(parts, key .. " = " .. serialize(v[k], seen))
            end
        end
        seen[v] = nil
        return "{ " .. table.concat(parts, ", ") .. " }"
    end
    return "nil"
end

local function parseValue(str)
    if type(str) ~= "string" then return str end
    str = str:gsub("^%s+", ""):gsub("%s+$", "")
    if str == "" then return nil end
    local fn = loadstring or load
    if fn then
        local ok, chunk = pcall(fn, "return " .. str)
        if ok and chunk then
            local ok2, r = pcall(chunk)
            if ok2 then return r end
        end
    end
    if str == "true"  then return true  end
    if str == "false" then return false end
    if str == "nil"   then return nil   end
    local num = tonumber(str)
    if num then return num end
    if (str:sub(1,1) == '"' and str:sub(-1) == '"') or
       (str:sub(1,1) == "'" and str:sub(-1) == "'") then
        return str:sub(2, -2)
    end
    return str
end

local function shortPreview(args, maxLen)
    maxLen = maxLen or 90
    local s = serialize(args)
    if #s > maxLen then s = s:sub(1, maxLen - 3) .. "..." end
    return s
end

--==============================================================
-- HOOK
--==============================================================
local EventLog = {}
local MAX_LOG = 40

local origNamecall
origNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local m = method:lower()

    if m == "fireserver" or m == "invokeserver" then
        local rName = (typeof(self) == "Instance") and self.Name or nil

        if rName and not C.hidden[rName] then
            table.insert(EventLog, 1, {
                name = rName, method = m,
                args = table.pack(...),
                time = os.clock(),
            })
            if #EventLog > MAX_LOG then table.remove(EventLog) end
        end

        if C.enabled and rName and C.rules[rName] and C.rules[rName].enabled then
            local rule = C.rules[rName]
            local orig = table.pack(...)
            local newArgs = {}
            local count = math.max(#orig, #rule.args)
            for i = 1, count do
                newArgs[i] = rule.args[i] ~= nil and rule.args[i] or orig[i]
            end
            return origNamecall(self, unpack(newArgs, 1, count))
        end
    end

    return origNamecall(self, ...)
end))

