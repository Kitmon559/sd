    EdTitle.TextColor3 = C.text
    EdTitle.Font = Enum.Font.GothamBold
    EdTitle.TextSize = 12
    EdTitle.TextXAlignment = Enum.TextXAlignment.Left
    EdTitle.TextTruncate = Enum.TextTruncate.AtEnd
    EdTitle.ZIndex = 205

    -- Кнопка закрытия редактора (реально закрывает — Destroy)
    local EdClose = Instance.new("TextButton", EdTitleBar)
    EdClose.Size = UDim2.new(0, 30, 0, 30)
    EdClose.Position = UDim2.new(1, -38, 0.5, -15)
    EdClose.BackgroundColor3 = Color3.fromRGB(58, 36, 44)
    EdClose.Text = "✕"
    EdClose.TextColor3 = Color3.fromRGB(255, 180, 180)
    EdClose.Font = Enum.Font.GothamBold
    EdClose.TextSize = 12
    EdClose.AutoButtonColor = false
    EdClose.ZIndex = 205
    corner(EdClose, 8)
    EdClose.MouseButton1Click:Connect(function() destroyEditor() end)
    EdClose.MouseEnter:Connect(function()
        Tween:Create(EdClose, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(215, 70, 82)}):Play()
    end)
    EdClose.MouseLeave:Connect(function()
        Tween:Create(EdClose, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(58, 36, 44)}):Play()
    end)

    -- === Drag за шапку ===
    do
        local drag, sPos, sMouse
        EdTitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                drag = true
                sMouse = input.Position
                sPos = EditorWindow.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then drag = false end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if drag and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - sMouse
                EditorWindow.Position = UDim2.new(
                    sPos.X.Scale, sPos.X.Offset + d.X,
                    sPos.Y.Scale, sPos.Y.Offset + d.Y)
            end
        end)
    end

    -- === Resize handle ===
    local EdResize = Instance.new("TextButton", EditorWindow)
    EdResize.Size = UDim2.new(0, 24, 0, 24)
    EdResize.Position = UDim2.new(1, -32, 1, -32)
    EdResize.BackgroundColor3 = C.accent
    EdResize.BackgroundTransparency = 0.15
    EdResize.Text = "◢"
    EdResize.TextColor3 = Color3.fromRGB(255, 255, 255)
    EdResize.Font = Enum.Font.GothamBold
    EdResize.TextSize = 12
    EdResize.AutoButtonColor = false
    EdResize.ZIndex = 210
    corner(EdResize, 7)
    EdResize.MouseEnter:Connect(function()
        Tween:Create(EdResize, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
    end)
    EdResize.MouseLeave:Connect(function()
        Tween:Create(EdResize, TweenInfo.new(0.15), {BackgroundTransparency = 0.15}):Play()
    end)

    do
        local resizing, startInput, startSize
        EdResize.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                startInput = input.Position
                startSize = EditorWindow.Size
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then resizing = false end
                end)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - startInput
                EditorWindow.Size = UDim2.new(0,
                    math.max(360, startSize.X.Offset + d.X), 0,
                    math.max(300, startSize.Y.Offset + d.Y))
            end
        end)
    end

    -- === Arg list ===
    local ArgScroll = Instance.new("ScrollingFrame", EditorWindow)
    ArgScroll.Size = UDim2.new(1, -20, 1, -152)
    ArgScroll.Position = UDim2.new(0, 10, 0, 54)
    ArgScroll.BackgroundTransparency = 1
    ArgScroll.BorderSizePixel = 0
    ArgScroll.ScrollBarThickness = 4
    ArgScroll.ScrollBarImageColor3 = C.accent
    ArgScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    ArgScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    ArgScroll.ZIndex = 203
    vlist(ArgScroll, 8)
    pad(ArgScroll, 4, 4, 4, 4)

    -- Источник аргументов: draft → rule → entry
    local sourceArgs = entry.args
    if C.rules[entry.name] and C.rules[entry.name].args then
        sourceArgs = C.rules[entry.name].args
    end
    if C.drafts[entry.name] then
        sourceArgs = C.drafts[entry.name]
    end

    local draft = {}

    local function buildArgCard(parent, index, value)
        local card = Instance.new("Frame", parent)
        card.Size = UDim2.new(1, -8, 0, 0)
        card.AutomaticSize = Enum.AutomaticSize.Y
        card.BackgroundColor3 = C.surface2
        card.BorderSizePixel = 0
        card.ZIndex = 204
        card.LayoutOrder = index
        corner(card, 8)
        pad(card, 10, 10, 12, 12)
        vlist(card, 6)

        local header = Instance.new("TextLabel", card)
        header.Size = UDim2.new(1, 0, 0, 14)
        header.BackgroundTransparency = 1
        header.Text = "ARGUMENT #" .. index
        header.TextColor3 = C.accent
        header.Font = Enum.Font.GothamBold
        header.TextSize = 10
        header.TextXAlignment = Enum.TextXAlignment.Left
        header.ZIndex = 205
        header.LayoutOrder = 1

        if type(value) == "table" then
            local keys = {}
            for k in pairs(value) do table.insert(keys, k) end
            table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)

            local sub = Instance.new("Frame", card)
            sub.Size = UDim2.new(1, 0, 0, 0)
            sub.AutomaticSize = Enum.AutomaticSize.Y
            sub.BackgroundColor3 = C.surface
            sub.BorderSizePixel = 0
            sub.ZIndex = 205
            sub.LayoutOrder = 2
            corner(sub, 7)
            pad(sub, 8, 8, 10, 10)
            vlist(sub, 6)

            local subTable = {}
            for _, k in ipairs(keys) do subTable[k] = value[k] end
            draft[index] = subTable

            for order, k in ipairs(keys) do
                local labelText = type(k) == "string" and k or ("[" .. tostring(k) .. "]")
                makeField(sub, order, labelText, value[k], function(txt)
                    draft[index][k] = parseValue(txt)
                    C.drafts[entry.name] = draft
                end)
            end
        else
            draft[index] = value
            makeField(card, 2, "value", value, function(txt)
                draft[index] = parseValue(txt)
                C.drafts[entry.name] = draft
            end)
        end
    end

    for i, arg in ipairs(sourceArgs) do
        buildArgCard(ArgScroll, i, arg)
    end

    local SaveBtn = Instance.new("TextButton", EditorWindow)
    SaveBtn.Size = UDim2.new(0.5, -15, 0, 40)
    SaveBtn.Position = UDim2.new(0, 10, 1, -50)
    SaveBtn.BackgroundColor3 = C.surface2
    SaveBtn.Text = "💾  Save rule"
    SaveBtn.TextColor3 = C.text
    SaveBtn.Font = Enum.Font.GothamBold
    SaveBtn.TextSize = 12
    SaveBtn.AutoButtonColor = false
    SaveBtn.ZIndex = 205
    corner(SaveBtn, 8)
    stroke(SaveBtn, C.border, 1, 0.3)
    SaveBtn.MouseEnter:Connect(function()
        Tween:Create(SaveBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.surface3}):Play()
    end)
    SaveBtn.MouseLeave:Connect(function()
        Tween:Create(SaveBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.surface2}):Play()
    end)

    local ApplyBtn = Instance.new("TextButton", EditorWindow)
    ApplyBtn.Size = UDim2.new(0.5, -15, 0, 40)
    ApplyBtn.Position = UDim2.new(0.5, 5, 1, -50)
    ApplyBtn.BackgroundColor3 = C.accent
    ApplyBtn.Text = "⚡  Hook — apply always"
    ApplyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ApplyBtn.Font = Enum.Font.GothamBold
    ApplyBtn.TextSize = 12
    ApplyBtn.AutoButtonColor = false
    ApplyBtn.ZIndex = 205
    corner(ApplyBtn, 8)
    local applyGrad = Instance.new("UIGradient", ApplyBtn)
    applyGrad.Color = ColorSequence.new(C.accent, C.accent2)
    applyGrad.Rotation = 45

    local function collectArgs()
        local out = {}
        for i = 1, #entry.args do out[i] = draft[i] end
        return out
    end

    SaveBtn.MouseButton1Click:Connect(function()
        C.rules[entry.name] = {
            args = collectArgs(),
            enabled = C.rules[entry.name] and C.rules[entry.name].enabled or true,
        }
        refreshHookBtn()
        SaveBtn.Text = "✅  Saved!"
        task.delay(1, function()
            if SaveBtn.Parent then SaveBtn.Text = "💾  Save rule" end
        end)
    end)

    ApplyBtn.MouseButton1Click:Connect(function()
        C.rules[entry.name] = {
            args = collectArgs(),
            enabled = true,
        }
        C.enabled = true
        refreshHookBtn()
        ApplyBtn.Text = "✅  Applied!"
        task.delay(1, function()
            if ApplyBtn.Parent then ApplyBtn.Text = "⚡  Hook — apply always" end
        end)
    end)
end

