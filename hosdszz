    local l = Instance.new("UIListLayout", p)
    l.Padding = UDim.new(0, padding or 6)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    return l
end

--==============================================================
-- SYNTAX HIGHLIGHTER (Cobalt)
--==============================================================
local KEYWORDS = {
    ["nil"]=1,["true"]=1,["false"]=1,["and"]=1,["or"]=1,["not"]=1,
    ["if"]=1,["then"]=1,["else"]=1,["elseif"]=1,["end"]=1,
    ["for"]=1,["while"]=1,["do"]=1,["repeat"]=1,["until"]=1,
    ["function"]=1,["return"]=1,["break"]=1,["in"]=1,
}
local BUILTINS = {
    ["game"]=1,["workspace"]=1,["script"]=1,["Enum"]=1,["Vector3"]=1,
    ["CFrame"]=1,["Color3"]=1,["UDim2"]=1,["Instance"]=1,["task"]=1,
    ["math"]=1,["string"]=1,["table"]=1,["os"]=1,["pairs"]=1,["ipairs"]=1,
    ["print"]=1,["warn"]=1,["pcall"]=1,["tostring"]=1,["tonumber"]=1,
}
local CLR = {
    kw="#C586C0", kwLocal="#569CD6", builtin="#4EC9B0",
    num="#B5CEA8", str="#CE9178", com="#6A9955",
    id="#9CDCFE", field="#4FC1FF", pct="#D4D4D4",
}
local function esc(s)
    s = s:gsub("&", "&amp;"); s = s:gsub("<", "&lt;"); s = s:gsub(">", "&gt;")
    return s
end
local function colorize(code)
    local s = esc(code)
    local out = {}
    local i, n = 1, #s
    local prevDot = false
    while i <= n do
        local c = s:sub(i, i)
        if c == "-" and s:sub(i+1, i+1) == "-" then
            local j = i
            while j <= n and s:sub(j, j) ~= "\n" do j = j + 1 end
            table.insert(out, string.format('<font color="%s">%s</font>', CLR.com, s:sub(i, j-1)))
            i = j
        elseif c == '"' or c == "'" then
            local q, j = c, i + 1
            while j <= n do
                local cj = s:sub(j, j)
                if cj == "\\" then j = j + 2
                elseif cj == q then j = j + 1 break
                else j = j + 1 end
            end
            table.insert(out, string.format('<font color="%s">%s</font>', CLR.str, s:sub(i, j-1)))
            i = j; prevDot = false
        elseif c:match("%d") then
            local j = i
            while j <= n and s:sub(j, j):match("[%d%.xXa-fA-F]") do j = j + 1 end
            table.insert(out, string.format('<font color="%s">%s</font>', CLR.num, s:sub(i, j-1)))
            i = j; prevDot = false
        elseif c:match("[%a_]") then
            local j = i
            while j <= n and s:sub(j, j):match("[%w_]") do j = j + 1 end
            local w = s:sub(i, j-1)
            local col
            if prevDot then col = CLR.field
            elseif w == "local" or w == "self" then col = CLR.kwLocal
            elseif KEYWORDS[w] then col = CLR.kw
            elseif BUILTINS[w] then col = CLR.builtin
            else col = CLR.id end
            table.insert(out, string.format('<font color="%s">%s</font>', col, w))
            i = j; prevDot = false
        elseif c == "." then
            table.insert(out, string.format('<font color="%s">%s</font>', CLR.pct, c))
            i = i + 1; prevDot = true
        else
            table.insert(out, string.format('<font color="%s">%s</font>', CLR.pct, c))
            i = i + 1; prevDot = false
        end
    end
    return table.concat(out)
end

