local EditorWindow = nil
local EditorShadow = nil
local currentEditorEntry = nil

local function destroyEditor()
    if EditorWindow then EditorWindow:Destroy() end
    if EditorShadow then EditorShadow:Destroy() end
    EditorWindow = nil
    EditorShadow = nil
    currentEditorEntry = nil
end

local function openEditor(entry)
    -- Если редактор уже открыт — закрываем старый
    if EditorWindow then
        EditorWindow:Destroy()
        EditorShadow:Destroy()
    end

    currentEditorEntry = entry

    -- Позиция: чуть правее и ниже основного окна
    local startPos = UDim2.new(0.5, -100, 0.5, -150)
    local startSize = UDim2.new(0, 480, 0, 420)

    -- Shadow
    EditorShadow = Instance.new("Frame", ScreenGui)
    EditorShadow.Size = startSize
    EditorShadow.Position = startPos
    EditorShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    EditorShadow.BackgroundTransparency = 0.6
    EditorShadow.BorderSizePixel = 0
    EditorShadow.ZIndex = 200
    corner(EditorShadow, 18)

    -- Main editor frame
    EditorWindow = Instance.new("Frame", ScreenGui)
    EditorWindow.Name = "EditorWindow"
    EditorWindow.Size = startSize
    EditorWindow.Position = startPos
    EditorWindow.BackgroundColor3 = C.bgTop
    EditorWindow.BorderSizePixel = 0
    EditorWindow.Active = true
    EditorWindow.ClipsDescendants = true
    EditorWindow.ZIndex = 202
    corner(EditorWindow, 14)
    stroke(EditorWindow, C.borderLt, 1, 0.3)

    local edGrad = Instance.new("UIGradient", EditorWindow)
    edGrad.Color = ColorSequence.new(C.bgTop, C.bgBot)
    edGrad.Rotation = 90

    local function syncEdShadow()
        EditorShadow.Size = EditorWindow.Size
        EditorShadow.Position = EditorWindow.Position
    end
    EditorWindow:GetPropertyChangedSignal("Size"):Connect(syncEdShadow)
    EditorWindow:GetPropertyChangedSignal("Position"):Connect(syncEdShadow)

    -- === Header ===
    local EdTitleBar = Instance.new("Frame", EditorWindow)
