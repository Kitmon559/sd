local function ruleCount()
    local n = 0
    for _ in pairs(C.rules) do n = n + 1 end
    return n
end

local function activeRuleCount()
    local n = 0
    for _, r in pairs(C.rules) do if r.enabled then n = n + 1 end end
    return n
end

local function refreshHookBtn()
    local total = ruleCount()
    local active = activeRuleCount()

    if C.enabled then
        HookLabel.Text = "Hook: Enabled"
        HookBtn.BackgroundColor3 = Color3.fromRGB(36, 54, 94)
        HookStroke.Color = C.accent
        HookStroke.Transparency = 0.2
        HookIconWrap.BackgroundColor3 = C.accent
        HookIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
        HookStatus.Text = "HOOK ON"
        HookStatus.TextColor3 = C.good
        HookStatus.BackgroundColor3 = Color3.fromRGB(28, 58, 42)
    else
        HookLabel.Text = "Hook: Disabled"
        HookBtn.BackgroundColor3 = C.surface
        HookStroke.Color = C.border
        HookStroke.Transparency = 0.4
        HookIconWrap.BackgroundColor3 = Color3.fromRGB(42, 46, 64)
        HookIcon.TextColor3 = C.accent
        HookStatus.Text = "HOOK OFF"
        HookStatus.TextColor3 = C.bad
        HookStatus.BackgroundColor3 = Color3.fromRGB(60, 30, 35)
    end

    HookCount.Text = active .. "/" .. total .. " rules"
end

