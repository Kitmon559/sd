function refreshHooksList()
    for _, c in ipairs(HooksScroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local any = false
    local order = 0
    for name, rule in pairs(C.rules) do
        any = true
        order = order + 1

        local Card = Instance.new("Frame", HooksScroll)
        Card.Size = UDim2.new(1, -8, 0, 66)
        Card.BackgroundColor3 = C.surface2
        Card.BorderSizePixel = 0
        Card.ZIndex = 5
        Card.LayoutOrder = order
        corner(Card, 9)
        stroke(Card, rule.enabled and C.accent or C.border, 1, rule.enabled and 0.3 or 0.6)

        local ind = Instance.new("Frame", Card)
        ind.Size = UDim2.new(0, 3, 1, -16)
        ind.Position = UDim2.new(0, 8, 0, 8)
        ind.BackgroundColor3 = rule.enabled and C.good or Color3.fromRGB(70, 72, 84)
        ind.BorderSizePixel = 0
        ind.ZIndex = 6
        corner(ind, 100)

        local nameLbl = Instance.new("TextLabel", Card)
        nameLbl.Size = UDim2.new(1, -190, 0, 18)
        nameLbl.Position = UDim2.new(0, 20, 0, 8)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = name
        nameLbl.TextColor3 = rule.enabled and C.text or C.textDim
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 12
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        nameLbl.ZIndex = 6

        local preview = Instance.new("TextLabel", Card)
        preview.Size = UDim2.new(1, -190, 0, 24)
        preview.Position = UDim2.new(0, 20, 0, 32)
        preview.BackgroundTransparency = 1
        preview.Text = shortPreview(rule.args, 80)
        preview.TextColor3 = C.textMute
        preview.Font = Enum.Font.Code
        preview.TextSize = 10
        preview.TextXAlignment = Enum.TextXAlignment.Left
        preview.TextTruncate = Enum.TextTruncate.AtEnd
        preview.ZIndex = 6

        local Toggle = Instance.new("TextButton", Card)
        Toggle.Size = UDim2.new(0, 52, 0, 26)
        Toggle.Position = UDim2.new(1, -142, 0, 10)
        Toggle.BackgroundColor3 = rule.enabled and C.accent or Color3.fromRGB(60, 62, 76)
        Toggle.Text = rule.enabled and "ON" or "OFF"
        Toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        Toggle.Font = Enum.Font.GothamBold
        Toggle.TextSize = 10
        Toggle.AutoButtonColor = false
        Toggle.ZIndex = 8
        corner(Toggle, 100)
        Toggle.MouseButton1Click:Connect(function()
            rule.enabled = not rule.enabled
            refreshHooksList()
            refreshHookBtn()
        end)

        local Del = Instance.new("TextButton", Card)
        Del.Size = UDim2.new(0, 30, 0, 30)
        Del.Position = UDim2.new(1, -40, 0.5, -15)
        Del.BackgroundColor3 = Color3.fromRGB(52, 34, 42)
        Del.Text = "✕"
        Del.TextColor3 = Color3.fromRGB(255, 150, 150)
        Del.Font = Enum.Font.GothamBold
        Del.TextSize = 11
        Del.AutoButtonColor = false
        Del.ZIndex = 8
        corner(Del, 100)
        Del.MouseEnter:Connect(function()
            Tween:Create(Del, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(200, 60, 72)}):Play()
        end)
        Del.MouseLeave:Connect(function()
            Tween:Create(Del, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(52, 34, 42)}):Play()
        end)
        Del.MouseButton1Click:Connect(function()
            C.rules[name] = nil
            C.drafts[name] = nil
            refreshHooksList()
            refreshHookBtn()
        end)
    end

    HooksEmpty.Visible = not any
end

--==============================================================
-- RENDER LOOP
--==============================================================
local renderedKeys = {}

ClearBtn.MouseButton1Click:Connect(function()
    EventLog = {}
    renderedKeys = {}
    for _, c in ipairs(Scroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
end)

task.spawn(function()
    while ScreenGui.Parent do
        for _, entry in ipairs(EventLog) do
            local key = entry.time .. "_" .. entry.name
            if not renderedKeys[key] then
                renderedKeys[key] = true
                createEventCard(entry)
            end
        end
        task.wait(0.3)
    end
end)

--==============================================================
-- VISIBILITY CONTROL (H — скрыть/показать всё)
--==============================================================
local menuVisible = true

local function applyVisibility()
    Main.Visible = menuVisible
    Shadow.Visible = menuVisible
    if EditorWindow then EditorWindow.Visible = menuVisible end
    if EditorShadow then EditorShadow.Visible = menuVisible end
end

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.H then
        menuVisible = not menuVisible
        applyVisibility()
    end
end)

-- Кнопка ✕ основного меню — ПОЛНОСТЬЮ прячет всё (включая редактор) + отключает ScreenGui
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui.Enabled = false
    menuVisible = true   -- на случай повторного включения
end)

-- Если ScreenGui выключен через ✕ и включен обратно — синхронизируем видимость
ScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
    if ScreenGui.Enabled and menuVisible then
        applyVisibility()
    end
end)

setTab("events")
refreshHookBtn()
